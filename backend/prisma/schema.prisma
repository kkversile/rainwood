  reservationAmount        Decimal                     @db.Decimal(12, 2)
  incidentalAmount         Decimal                     @db.Decimal(12, 2)
  taxAmount                Decimal                     @default(0) @db.Decimal(12, 2)
  discountAmount           Decimal                     @default(0) @db.Decimal(12, 2)
  adjustmentAmount         Decimal                     @default(0) @db.Decimal(12, 2)
  grossAmount              Decimal                     @db.Decimal(12, 2)
  paidAmount               Decimal                     @db.Decimal(12, 2)
  balanceAmount            Decimal                     @db.Decimal(12, 2)
  finalFolioNumber         String?                     @unique
  settledAt                DateTime?
  settledById              String?
  settledBy                User?                       @relation("SettlementActor", fields: [settledById], references: [id], onDelete: SetNull)
  overrideReason           String?
  overrideAuthorizedById   String?
  overrideAuthorizedByUser User?                       @relation("SettlementOverrideAuthorizer", fields: [overrideAuthorizedById], references: [id], onDelete: SetNull)
  overrideAuthorizedBy     String?
  notes                    String?
  snapshot                 Json?
  createdAt                DateTime                    @default(now())
  updatedAt                DateTime                    @updatedAt

  @@index([status, settledAt])
}

model Room {
  id                 String                      @id @default(cuid())
  hotelId            String
  hotel              Hotel                       @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  roomTypeId         String
  roomType           RoomType                    @relation(fields: [roomTypeId], references: [id], onDelete: Restrict)
  roomNumber         String
  floor              String?
  wing               String?
  status             RoomOperationalStatus       @default(AVAILABLE)
  active             Boolean                     @default(true)
  assignments        ReservationRoomAssignment[]
  housekeepingTasks  HousekeepingTask[]
  maintenanceTickets MaintenanceTicket[]
  lostFoundItems     LostFoundItem[]
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt

  @@unique([hotelId, roomNumber])
  @@index([hotelId, roomTypeId, active])
  @@index([hotelId, status])
}

model HousekeepingTask {
  // PostgreSQL migration 20260927170000_enforce_single_active_housekeeping_task
  // owns a partial unique index so each room has at most one PENDING, ACCEPTED,
  // or CLEANING task while retaining all completed/cancelled history.
  id                String                 @id @default(cuid())
  hotelId           String
  hotel             Hotel                  @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  roomId            String
  room              Room                   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  assignedToId      String?
  assignedTo        User?                  @relation("HousekeepingTaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  status            HousekeepingTaskStatus @default(PENDING)
  createdAt         DateTime               @default(now())
  acceptedAt        DateTime?
  cleaningStartedAt DateTime?
  completedAt       DateTime?
  createdById       String?
  createdBy         User?                  @relation("HousekeepingTaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  completedById     String?
  completedBy       User?                  @relation("HousekeepingTaskCompleter", fields: [completedById], references: [id], onDelete: SetNull)
  note              String?
  issueNote         String?
  issueReportedAt   DateTime?
  issueReportedById String?
  issueReportedBy   User?                  @relation("HousekeepingIssueReporter", fields: [issueReportedById], references: [id], onDelete: SetNull)
  updatedAt         DateTime               @updatedAt
  maintenanceTicket MaintenanceTicket?

  @@index([hotelId, status])
  @@index([roomId, status])
  @@index([assignedToId, status])
}

model MaintenanceTicket {
  id                  String                  @id @default(cuid())
  hotelId             String
  hotel               Hotel                   @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  roomId              String?
  room                Room?                   @relation(fields: [roomId], references: [id], onDelete: SetNull)
  housekeepingTaskId  String?                 @unique
  housekeepingTask    HousekeepingTask?       @relation(fields: [housekeepingTaskId], references: [id], onDelete: SetNull)
  source              MaintenanceTicketSource
  category            MaintenanceCategory
  priority            MaintenancePriority     @default(NORMAL)
  status              MaintenanceTicketStatus @default(OPEN)
  title               String
  description         String
  reportedById        String?
  reportedBy          User?                   @relation("MaintenanceTicketReporter", fields: [reportedById], references: [id], onDelete: SetNull)
  reportedAt          DateTime                @default(now())
  assignedToId        String?
  assignedTo          User?                   @relation("MaintenanceTicketAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedAt          DateTime?
  startedAt           DateTime?
  completedAt         DateTime?
  resolutionNote      String?
  requiresOutOfOrder  Boolean                 @default(false)
  outOfOrderAppliedAt DateTime?
  outOfOrderClearedAt DateTime?
  createdById         String?
  createdBy           User?                   @relation("MaintenanceTicketCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  @@index([hotelId, status])
  @@index([roomId, status])
  @@index([assignedToId, status])
  @@index([hotelId, priority, status])
}

model ReservationRoomAssignment {
  id                String              @id @default(cuid())
  reservationId     String
  reservation       Reservation         @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  reservationLineId String?
  reservationLine   ReservationLine?    @relation(fields: [reservationLineId], references: [id], onDelete: SetNull)
  roomId            String
  room              Room                @relation(fields: [roomId], references: [id], onDelete: Restrict)
  assignedAt        DateTime            @default(now())
  assignedById      String
  assignedBy        User                @relation("RoomAssignmentAssignedBy", fields: [assignedById], references: [id], onDelete: Restrict)
  unassignedAt      DateTime?
  unassignedById    String?
  unassignedBy      User?               @relation("RoomAssignmentUnassignedBy", fields: [unassignedById], references: [id], onDelete: SetNull)
  reason            String?
  serviceOrders     GuestServiceOrder[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([reservationId, unassignedAt])
  @@index([roomId, unassignedAt])
  @@index([reservationLineId])
}

model ReservationFolioCharge {
  id             String              @id @default(cuid())
  reservationId  String
  reservation    Reservation         @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  category       FolioChargeCategory
  description    String
  quantity       Decimal             @default(1) @db.Decimal(10, 2)
  unitAmount     Decimal             @db.Decimal(12, 2)
  taxableAmount  Decimal             @default(0) @db.Decimal(12, 2)
  taxAmount      Decimal             @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal             @db.Decimal(12, 2)
  postingDate    DateTime            @db.Date
  note           String?
  status         FolioChargeStatus   @default(POSTED)
  postedById     String
  postedBy       User                @relation("FolioChargePostedBy", fields: [postedById], references: [id])
  voidedAt       DateTime?
  voidedById     String?
  voidedBy       User?               @relation("FolioChargeVoidedBy", fields: [voidedById], references: [id], onDelete: SetNull)
  voidReason     String?
  idempotencyKey String?             @unique
  serviceOrder   GuestServiceOrder?  @relation("ServiceOrderFolioCharge")
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([reservationId, postingDate])
  @@index([reservationId, status])
}

model ReservationLine {
  id              String                      @id @default(cuid())
  reservationId   String
  reservation     Reservation                 @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  roomTypeId      String
  roomType        RoomType                    @relation(fields: [roomTypeId], references: [id])
  ratePlanId      String
  ratePlan        RatePlan                    @relation(fields: [ratePlanId], references: [id])
  checkIn         DateTime                    @db.Date
  checkOut        DateTime                    @db.Date
  rooms           Int
  adults          Int
  children        Int                         @default(0)
  nightlyRate     Decimal                     @db.Decimal(12, 2)
  taxAmount       Decimal                     @default(0) @db.Decimal(12, 2)
  lineTotal       Decimal                     @db.Decimal(12, 2)
  priceSnapshot   Json
  nights          ReservationRoomNight[]
  roomAssignments ReservationRoomAssignment[]
}

model ReservationRoomNight {
  id                String          @id @default(cuid())
  reservationLineId String
  reservationLine   ReservationLine @relation(fields: [reservationLineId], references: [id], onDelete: Cascade)
  date              DateTime        @db.Date
  rooms             Int
  amount            Decimal         @db.Decimal(12, 2)
  taxAmount         Decimal         @default(0) @db.Decimal(12, 2)
  totalAmount       Decimal         @db.Decimal(12, 2)

  @@unique([reservationLineId, date])
  @@index([date])
}

model Payment {
  id                String          @id @default(cuid())
  reservationId     String
  reservation       Reservation     @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  amount            Decimal         @db.Decimal(12, 2)
  mode              PaymentMode
  provider          PaymentProvider @default(MANUAL)
  providerOrderId   String?
  providerPaymentId String?
  reference         String?
  proofFileId       String?
  proofFile         StoredFile?     @relation("PaymentProof", fields: [proofFileId], references: [id])
  verified          Boolean         @default(false)
  verifiedById      String?
  verifiedBy        User?           @relation("PaymentVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  paidAt            DateTime?
  idempotencyKey    String?         @unique
  createdAt         DateTime        @default(now())

  @@unique([provider, providerPaymentId])
  @@index([reservationId, verified])
}

model PaymentAttempt {
  id                String               @id @default(cuid())
  reservationId     String
  reservation       Reservation          @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  provider          PaymentProvider
  providerOrderId   String               @unique
  providerPaymentId String?              @unique
  idempotencyKey    String               @unique
  amount            Decimal              @db.Decimal(12, 2)
  currency          String               @default("INR")
  status            PaymentAttemptStatus @default(CREATED)
  providerPayload   Json?
  expiresAt         DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
}

model WalletRechargeAttempt {
  id                String               @id @default(cuid())
  walletId          String
  wallet            AgentWallet          @relation(fields: [walletId], references: [id], onDelete: Cascade)
  provider          PaymentProvider
  providerOrderId   String               @unique
  providerPaymentId String?              @unique
  idempotencyKey    String               @unique
  amount            Decimal              @db.Decimal(12, 2)
  currency          String               @default("INR")
  status            PaymentAttemptStatus @default(CREATED)
  providerPayload   Json?
  expiresAt         DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([walletId, status, createdAt])
}

model WebhookEvent {
  id              String          @id @default(cuid())
  provider        PaymentProvider
  externalEventId String
  eventType       String
  signature       String?
  payloadChecksum String
  payload         Json
  status          WebhookStatus   @default(RECEIVED)
  attempts        Int             @default(0)
  lastError       String?
  processedAt     DateTime?
  completedAt     DateTime?
  createdAt       DateTime        @default(now())

  @@unique([provider, externalEventId])
  @@index([status, createdAt])
}

model AxisSyncLog {
  id                String       @id @default(cuid())
  reservationId     String?
  reservation       Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  idempotencyKey    String       @unique
  direction         String
  entityType        String
  externalReference String?
  status            SyncStatus
  payload           Json
  response          Json?
  errorMessage      String?
  attempts          Int          @default(0)
  nextAttemptAt     DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([status, nextAttemptAt])
}

model OutboxJob {
  id             String    @id @default(cuid())
  type           String
  aggregateType  String
  aggregateId    String
  idempotencyKey String    @unique
  payload        Json
  status         JobStatus @default(PENDING)
  attempts       Int       @default(0)
  availableAt    DateTime  @default(now())
  lockedAt       DateTime?
  lockedBy       String?
  lastError      String?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, availableAt])
  @@index([aggregateType, aggregateId])
}

model StoredFile {
  id               String          @id @default(cuid())
  kind             FileKind
  storageKey       String          @unique
  originalName     String
  mimeType         String
  size             Int
  checksum         String
  createdById      String?
  createdBy        User?           @relation("FileUploader", fields: [createdById], references: [id], onDelete: SetNull)
  paymentProofs    Payment[]       @relation("PaymentProof")
  vouchers         Voucher[]       @relation("VoucherFile")
  agentDocuments   AgentDocument[]
  profileImageUser User?           @relation("ProfileImage")
  createdAt        DateTime        @default(now())
}

model Voucher {
  id            String      @id @default(cuid())
  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  version       Int
  fileId        String
  file          StoredFile  @relation("VoucherFile", fields: [fileId], references: [id])
  metadata      Json
  generatedAt   DateTime    @default(now())
  emailedAt     DateTime?
  supersededAt  DateTime?
  createdAt     DateTime    @default(now())

  @@unique([reservationId, version])
}

model AuditLog {
  id            String   @id @default(cuid())
  actorUserId   String?
  actor         User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  action        String
  entityType    String
  entityId      String?
  before        Json?
  after         Json?
  ipAddress     String?
  userAgent     String?
  correlationId String?
  createdAt     DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
}

model SiteSetting {
  key       String   @id
  value     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CancellationRequest {
  id             String             @id @default(cuid())
  reservationId  String
  reservation    Reservation        @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  status         CancellationStatus @default(REQUESTED)
  reason         String
  idempotencyKey String             @unique
  requestedById  String?
  requestedBy    User?              @relation("CancellationRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  approvedById   String?
  approvedBy     User?              @relation("CancellationApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  refundAmount   Decimal            @default(0) @db.Decimal(12, 2)
  policyResult   Json
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([reservationId, status])
}

model ReservationModification {
  id              String             @id @default(cuid())
  reservationId   String
  reservation     Reservation        @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  fromVersion     Int
  toVersion       Int
  type            ModificationType
  status          ModificationStatus @default(REQUESTED)
  changes         Json
  priceDifference Decimal            @default(0) @db.Decimal(12, 2)
  idempotencyKey  String             @unique
  createdById     String?
  createdBy       User?              @relation("ModificationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime           @default(now())

  @@index([reservationId, createdAt])
}

model WaitlistEntry {
  id         String    @id @default(cuid())
  hotelId    String
  hotel      Hotel     @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  roomTypeId String?
  roomType   RoomType? @relation(fields: [roomTypeId], references: [id], onDelete: SetNull)
  guestName  String
  email      String
  checkIn    DateTime  @db.Date
  checkOut   DateTime  @db.Date
  rooms      Int       @default(1)
  status     String    @default("WAITING")
  createdAt  DateTime  @default(now())

  @@index([hotelId, checkIn, status])
}
