generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  CORPORATE_ADMIN
  ADMIN
  RESERVATION
  ACCOUNTS
  VIEWER
  AGENT
  SERVICE_STAFF
}

enum StaffDepartment {
  FOOD_BEVERAGE
  HOUSEKEEPING
  MAINTENANCE
  ROOM_SERVICE
  FRONT_OFFICE
  OTHER
}

enum GuestNoteCategory {
  PREFERENCE
  SERVICE
  COMPLAINT
  COMPLIMENT
  MANAGEMENT
}

enum GuestNoteVisibility {
  FRONT_OFFICE
  SERVICE_STAFF
  MANAGEMENT_ONLY
}

enum BookingSource {
  WEBSITE
  DIRECT
  PHONE
  EMAIL
  WHATSAPP
  WALK_IN
  AGENT
  COMPANY
  OTA
}

enum PromotionDiscountType {
  PERCENT
  FIXED
}

enum RateAdjustmentType {
  PERCENT
  FIXED
}

enum ReservationStatus {
  DRAFT
  HELD
  PENDING_PAYMENT
  TENTATIVE
  CONFIRMED
  CANCELLED
  NO_SHOW
  COMPLETED
  MODIFIED
  EXPIRED
}

enum StayStatus {
  EXPECTED
  CHECKED_IN
  CHECKED_OUT
  NO_SHOW
}

enum ReservationSettlementStatus {
  OPEN
  SETTLED
  PARTIAL
  WRITTEN_OFF
  VOIDED
}

enum HotelBusinessDayStatus {
  OPEN
  CLOSED
}

enum RoomOperationalStatus {
  AVAILABLE
  OCCUPIED
  DIRTY
  CLEANING
  OUT_OF_ORDER
}

enum HousekeepingTaskStatus {
  PENDING
  ACCEPTED
  CLEANING
  COMPLETED
  CANCELLED
}

enum MaintenanceTicketSource {
  HOUSEKEEPING
  FRONT_DESK
  STAFF
  ADMIN
  OTHER
}

enum MaintenanceCategory {
  ELECTRICAL
  PLUMBING
  HVAC
  TV_ELECTRONICS
  FURNITURE
  BATHROOM
  DOOR_LOCK
  INTERNET
  GENERAL
  OTHER
}

enum MaintenancePriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum MaintenanceTicketStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PENDING
  PARTIALLY_PAID
  PAID
  FAILED
  REFUND_PENDING
  PARTIALLY_REFUNDED
  REFUNDED
}

enum PaymentMode {
  GATEWAY
  WALLET
  UPI
  BANK_TRANSFER
  CASH
  COMPANY_CREDIT
  CHEQUE
  OTHER
}

enum ExpenseStatus {
  DRAFT
  SUBMITTED
  APPROVED
  PAID
  CANCELLED
}

enum CorporatePricingType {
  FIXED
  DISCOUNT_PERCENT
}

enum InquiryStatus {
  NEW
  CONTACTED
  QUOTE_SENT
  FOLLOW_UP
  CONVERTED
  LOST
}

enum InquiryFollowUpMethod {
  CALL
  WHATSAPP
  EMAIL
  IN_PERSON
  OTHER
}

enum DocumentSequenceType {
  EXPENSE
  INQUIRY
  SERVICE_ORDER
  LOST_FOUND
}

enum ServiceItemType {
  FOOD
  BEVERAGE
  LAUNDRY
  ROOM_SERVICE
  OTHER
}

enum GuestServiceOrderStatus {
  DRAFT
  POSTED
  VOIDED
}

enum LostFoundType {
  LOST
  FOUND
}

enum LostFoundStatus {
  OPEN
  MATCHED
  RETURNED
  DISPOSED
}

enum PaymentProvider {
  MOCK
  RAZORPAY
  CASHFREE
  MANUAL
}

enum PaymentAttemptStatus {
  CREATED
  PENDING
  SUCCESS
  FAILED
  EXPIRED
  REFUNDED
}

enum WalletTransactionType {
  RECHARGE
  BOOKING_DEBIT
  BOOKING_REFUND
}

enum SyncStatus {
  NOT_REQUIRED
  PENDING
  PROCESSING
  SYNCED
  RETRY
  FAILED
  MANUAL_ACTION_REQUIRED
  DEAD_LETTER
}

enum HoldStatus {
  ACTIVE
  CONVERTED
  RELEASED
  EXPIRED
}

enum JobStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  DEAD_LETTER
}

enum FileKind {
  PAYMENT_PROOF
  VOUCHER
  OTHER
}

enum AgentDocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ContactRequestStatus {
  NEW
  IN_PROGRESS
  RESOLVED
}

enum CancellationStatus {
  REQUESTED
  APPROVED
  REJECTED
  COMPLETED
}

enum CancellationRuleType {
  FREE_CANCELLATION
  FIXED_AMOUNT
  PERCENTAGE
  FIRST_NIGHT
  NON_REFUNDABLE
  NO_SHOW
}

enum ModificationType {
  GUEST_DETAILS
  INSTRUCTIONS
  INVENTORY
  PRICE
}

enum ModificationStatus {
  REQUESTED
  APPROVED
  APPLIED
  REJECTED
}

enum WebhookStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
}

enum AgentPaymentPolicy {
  PERCENTAGE
  CREDIT
}

enum PaymentMilestoneDueType {
  ON_BOOKING
  DAYS_BEFORE_CHECKIN
}

enum SupplementaryChargeScope {
  AGENTS
  ALL
}

enum FolioChargeCategory {
  FOOD_AND_BEVERAGE
  MINIBAR
  LAUNDRY
  EXTRA_BED
  TRANSPORT
  ACTIVITY
  SPA
  ROOM_SERVICE
  EARLY_CHECKIN
  LATE_CHECKOUT
  ROOM_UPGRADE
  DAMAGE
  OTHER
}

enum FolioChargeStatus {
  POSTED
  VOIDED
}

model User {
  id                         String                      @id @default(cuid())
  email                      String                      @unique
  passwordHash               String
  name                       String
  companyName                String?
  contactPerson              String?
  mobile                     String?
  gstin                      String?
  place                      String?
  addressLine1               String?
  addressLine2               String?
  state                      String?
  pinCode                    String?
  additionalInformation      String?
  role                       UserRole                    @default(RESERVATION)
  staffDepartment            StaffDepartment?
  jobTitle                   String?
  staffHotelId               String?
  staffHotel                 Hotel?                      @relation("StaffHotel", fields: [staffHotelId], references: [id], onDelete: SetNull)
  active                     Boolean                     @default(true)
  agentPaymentPolicy         AgentPaymentPolicy?
  bookingPaymentPercent      Decimal?                    @db.Decimal(5, 2)
  tokenVersion               Int                         @default(0)
  failedLoginCount           Int                         @default(0)
  lockedUntil                DateTime?
  refreshTokens              RefreshToken[]
  auditLogs                  AuditLog[]                  @relation("AuditActor")
  createdReservations        Reservation[]               @relation("ReservationCreator")
  reconfirmedReservations    Reservation[]               @relation("ReservationReconfirmedBy")
  checkedInReservations      Reservation[]               @relation("ReservationCheckedInBy")
  checkedOutReservations     Reservation[]               @relation("ReservationCheckedOutBy")
  reservationSettlements     ReservationSettlement[]     @relation("SettlementActor")
  settlementOverrides        ReservationSettlement[]     @relation("SettlementOverrideAuthorizer")
  closedBusinessDays         HotelBusinessDay[]          @relation("BusinessDayCloser")
  uploadedFiles              StoredFile[]                @relation("FileUploader")
  agentDocuments             AgentDocument[]
  profileImageFileId         String?                     @unique
  profileImageFile           StoredFile?                 @relation("ProfileImage", fields: [profileImageFileId], references: [id], onDelete: SetNull)
  verifiedPayments           Payment[]                   @relation("PaymentVerifier")
  requestedCancellations     CancellationRequest[]       @relation("CancellationRequester")
  approvedCancellations      CancellationRequest[]       @relation("CancellationApprover")
  createdModifications       ReservationModification[]   @relation("ModificationCreator")
  postedFolioCharges         ReservationFolioCharge[]    @relation("FolioChargePostedBy")
  voidedFolioCharges         ReservationFolioCharge[]    @relation("FolioChargeVoidedBy")
  postedServiceOrders        GuestServiceOrder[]         @relation("ServiceOrderPostedBy")
  voidedServiceOrders        GuestServiceOrder[]         @relation("ServiceOrderVoidedBy")
  reportedLostFoundItems     LostFoundItem[]             @relation("LostFoundReportedBy")
  assignedLostFoundItems     LostFoundItem[]             @relation("LostFoundAssignedTo")
  returnedLostFoundItems     LostFoundItem[]             @relation("LostFoundReturnedBy")
  assignedRatePlans          AgentRatePlan[]
  guestNotes                 GuestNote[]
  paymentMilestones          AgentPaymentMilestone[]
  agentHolds                 InventoryHold[]             @relation("AgentHolds")
  assignedRoomStays          ReservationRoomAssignment[] @relation("RoomAssignmentAssignedBy")
  unassignedRoomStays        ReservationRoomAssignment[] @relation("RoomAssignmentUnassignedBy")
  housekeepingTasksAssigned  HousekeepingTask[]          @relation("HousekeepingTaskAssignee")
  housekeepingTasksCreated   HousekeepingTask[]          @relation("HousekeepingTaskCreator")
  housekeepingTasksCompleted HousekeepingTask[]          @relation("HousekeepingTaskCompleter")
  housekeepingIssuesReported HousekeepingTask[]          @relation("HousekeepingIssueReporter")
  maintenanceTicketsReported MaintenanceTicket[]         @relation("MaintenanceTicketReporter")
  maintenanceTicketsAssigned MaintenanceTicket[]         @relation("MaintenanceTicketAssignee")
  maintenanceTicketsCreated  MaintenanceTicket[]         @relation("MaintenanceTicketCreator")
  createdExpenses            Expense[]                   @relation("ExpenseCreator")
  approvedExpenses           Expense[]                   @relation("ExpenseApprover")
  assignedInquiries          BookingInquiry[]            @relation("InquiryAssignee")
  createdInquiryFollowUps    InquiryFollowUp[]           @relation("InquiryFollowUpCreator")
  wallet                     AgentWallet?
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt

  @@index([staffHotelId, role])
}

model Permission {
  id          String           @id @default(cuid())
  code        String           @unique
  description String
  roles       RolePermission[]
}

model RolePermission {
  role         UserRole
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([role, permissionId])
}

model RefreshToken {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String    @unique
  familyId     String
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime  @default(now())

  @@index([userId, familyId])
  @@index([expiresAt])
  @@index([familyId, revokedAt])
}

model Hotel {
  id                      String                     @id @default(cuid())
  code                    String                     @unique
  name                    String
  slug                    String                     @unique
  city                    String
  mobile                  String?
  email                   String?
  place                   String?
  propertyType            String?
  location                String?
  country                 String?
  state                   String?
  address                 String?
  pincode                 String?
  latitude                String?
  longitude               String?
  category                String?
  margin                  String?
  powerBackup             Boolean                    @default(false)
  description             String?
  active                  Boolean                    @default(true)
  seoTitle                String?
  seoDescription          String?
  canonicalPath           String?
  ogImageUrl              String?
  virtualTourUrl          String?
  timezoneName            String                     @default("Asia/Kolkata")
  axisPropertyId          String?                    @unique
  rooms                   RoomType[]
  physicalRooms           Room[]
  ratePlanMasters         RatePlanMaster[]
  images                  HotelImage[]
  videos                  HotelVideo[]
  amenities               HotelAmenity[]
  reviews                 HotelReview[]
  taxes                   Tax[]
  charges                 Charge[]
  supplementaryCharges    HotelSupplementaryCharge[]
  cancellationRules       CancellationRule[]
  policy                  HotelPolicy?
  contacts                HotelContact[]
  documents               HotelDocument[]
  locationProfile         HotelLocationProfile?
  locationAttractions     HotelLocationAttraction[]
  locationTransports      HotelLocationTransport[]
  reservations            Reservation[]
  guestProfiles           GuestProfile[]             @relation("GuestPreferredHotel")
  guestNotes              GuestNote[]                @relation("GuestNoteHotel")
  staffUsers              User[]                     @relation("StaffHotel")
  housekeepingTasks       HousekeepingTask[]
  maintenanceTickets      MaintenanceTicket[]
  holds                   InventoryHold[]
  waitlist                WaitlistEntry[]
  businessDays            HotelBusinessDay[]
  promotions              Promotion[]
  rateSeasons             RateSeason[]
  yieldRules              YieldRule[]
  revenueForecasts        RevenueForecastSnapshot[]
  expenseCategories       ExpenseCategory[]
  vendors                 Vendor[]
  expenses                Expense[]
  documentSequences       DocumentSequence[]
  serviceItems            ServiceItem[]
  serviceOrders           GuestServiceOrder[]
  lostFoundItems          LostFoundItem[]
  corporateLinks          CorporateAccountHotel[]
  corporateRateAgreements CorporateRateAgreement[]
  inquiries               BookingInquiry[]
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt

  @@index([active, slug])
}

model HotelBusinessDay {
  id           String                 @id @default(cuid())
  hotelId      String
  hotel        Hotel                  @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  businessDate DateTime               @db.Date
  status       HotelBusinessDayStatus @default(OPEN)
  openedAt     DateTime               @default(now())
  closedAt     DateTime?
  closedById   String?
  closedBy     User?                  @relation("BusinessDayCloser", fields: [closedById], references: [id], onDelete: SetNull)
  summary      Json?
  exceptions   Json?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@unique([hotelId, businessDate])
  @@index([hotelId, status, businessDate])
}

model RatePlanMaster {
  id          String     @id @default(cuid())
  hotelId     String
  hotel       Hotel      @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  code        String
  name        String
  mealPlan    String
  description String?
  active      Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  assignments RatePlan[]

  @@unique([hotelId, code])
  @@index([hotelId, active])
}

model HotelLocationProfile {
  id              String   @id @default(cuid())
  hotelId         String   @unique
  hotel           Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  addressLine1    String?
  addressLine2    String?
  timezone        String   @default("IST (UTC +5:30)")
  bestTimeToVisit String?
  elevation       String?
  weather         String?
  nearbyCity      String?
  accessRoad      String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model HotelLocationAttraction {
  id        String   @id @default(cuid())
  hotelId   String
  hotel     Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name      String
  distance  String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([hotelId, sortOrder])
}

model HotelLocationTransport {
  id        String   @id @default(cuid())
  hotelId   String
  hotel     Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  type      String
  name      String
  distance  String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([hotelId, sortOrder])
}

model HotelReview {
  id          String   @id @default(cuid())
  hotelId     String
  hotel       Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  rating      Int
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([hotelId, createdAt])
}

model HotelPolicy {
  id                 String   @id @default(cuid())
  hotelId            String   @unique
  hotel              Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  checkInTime        String?
  checkOutTime       String?
  childMinAge        Int      @default(0)
  childMaxAge        Int      @default(12)
  childPolicyType    String   @default("FREE")
  houseRules         String?
  cancellationRules  Json?
  noShowPolicy       String?
  noShowAmount       Decimal? @db.Decimal(12, 2)
  noShowCustomText   String?
  amendmentPolicy    String?
  termsAndConditions String?
  allowEarlyCheckIn  Boolean  @default(false)
  allowLateCheckOut  Boolean  @default(false)
  allowExtraBed      Boolean  @default(false)
  allowPets          Boolean  @default(false)
  allowOutsideFood   Boolean  @default(false)
  smokingAllowed     Boolean  @default(false)
  alcoholAllowed     Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model HotelContact {
  id            String   @id @default(cuid())
  hotelId       String
  hotel         Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  contactType   String
  name          String
  designation   String?
  department    String?
  email         String
  phone         String?
  mobile        String?
  preferredMode String   @default("EMAIL")
  primary       Boolean  @default(false)
  remarks       String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([hotelId, active])
}

model HotelDocument {
  id           String    @id @default(cuid())
  hotelId      String
  hotel        Hotel     @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  documentType String
  name         String
  fileId       String
  fileName     String
  expiryDate   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([hotelId, documentType])
}

model HotelImage {
  id        String   @id @default(cuid())
  hotelId   String
  hotel     Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  url       String
  altText   String
  category  String   @default("OTHERS")
  isMain    Boolean  @default(false)
  sortOrder Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([hotelId, published, sortOrder])
}

model HotelVideo {
  id           String   @id @default(cuid())
  hotelId      String
  hotel        Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  fileId       String
  url          String
  title        String
  fileName     String
  mimeType     String
  size         Int
  duration     String?
  thumbnailUrl String?
  createdAt    DateTime @default(now())

  @@index([hotelId, createdAt])
}

model Amenity {
  id     String         @id @default(cuid())
  code   String         @unique
  name   String
  hotels HotelAmenity[]
}

model HotelAmenity {
  hotelId          String
  amenityId        String
  quantity         Int     @default(1)
  availabilityType String  @default("24/7")
  startTime        String?
  endTime          String?
  active           Boolean @default(true)
  hotel            Hotel   @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  amenity          Amenity @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([hotelId, amenityId])
}

model RoomType {
  id                      String                    @id @default(cuid())
  hotelId                 String
  hotel                   Hotel                     @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  code                    String
  name                    String
  roomTypeTitle           String?
  roomsAvailable          Int                       @default(0)
  preferredFor            String                    @default("")
  acAvailable             Boolean                   @default(false)
  description             String?
  maxAdults               Int                       @default(2)
  maxChildren             Int                       @default(1)
  maxOccupancy            Int                       @default(3)
  checkInTime             String?
  checkOutTime            String?
  gstType                 String                    @default("Included")
  gstPercentage           String                    @default("GST - 0%")
  inbuiltAmenities        String                    @default("")
  breakfastIncluded       Boolean                   @default(false)
  lunchIncluded           Boolean                   @default(false)
  dinnerIncluded          Boolean                   @default(false)
  active                  Boolean                   @default(true)
  axisRoomId              String?
  images                  RoomImage[]
  ratePlans               RatePlan[]
  inventory               InventoryDay[]
  lines                   ReservationLine[]
  holdLines               InventoryHoldLine[]
  waitlist                WaitlistEntry[]
  physicalRooms           Room[]
  guestPreferredProfiles  GuestProfile[]            @relation("GuestPreferredRoomType")
  promotionRooms          PromotionRoomType[]
  seasonRooms             RateSeasonRoomType[]
  yieldRules              YieldRule[]
  revenueForecasts        RevenueForecastSnapshot[]
  corporateRateAgreements CorporateRateAgreement[]
  inquiries               BookingInquiry[]

  @@unique([hotelId, code])
  @@unique([hotelId, axisRoomId])
  @@index([hotelId, active])
}

model RoomImage {
  id         String   @id @default(cuid())
  roomTypeId String
  roomType   RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  url        String
  altText    String
  sortOrder  Int      @default(0)
  published  Boolean  @default(true)

  @@index([roomTypeId, published, sortOrder])
}

model RatePlan {
  id                      String                   @id @default(cuid())
  roomTypeId              String
  roomType                RoomType                 @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  masterId                String
  master                  RatePlanMaster           @relation(fields: [masterId], references: [id], onDelete: Restrict)
  code                    String
  name                    String
  mealPlan                String
  description             String?
  active                  Boolean                  @default(true)
  axisRatePlanId          String?
  rates                   RateDay[]
  lines                   ReservationLine[]
  holdLines               InventoryHoldLine[]
  cancellationRules       CancellationRule[]
  assignedAgents          AgentRatePlan[]
  promotionRates          PromotionRatePlan[]
  seasonRates             RateSeasonRatePlan[]
  corporateRateAgreements CorporateRateAgreement[]

  @@unique([roomTypeId, code])
  @@unique([roomTypeId, masterId])
  @@unique([roomTypeId, axisRatePlanId])
  @@index([roomTypeId, active])
}

model ContactRequest {
  id        String               @id @default(cuid())
  name      String
  email     String
  message   String
  status    ContactRequestStatus @default(NEW)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([status, createdAt])
}

model AgentRatePlan {
  id         String   @id @default(cuid())
  agentId    String
  agent      User     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  ratePlanId String
  ratePlan   RatePlan @relation(fields: [ratePlanId], references: [id], onDelete: Cascade)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([agentId, ratePlanId])
  @@index([ratePlanId])
  @@index([agentId, active])
}

model AgentWallet {
  id               String                  @id @default(cuid())
  agentId          String                  @unique
  agent            User                    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  currency         String                  @default("INR")
  balance          Decimal                 @default(0) @db.Decimal(14, 2)
  transactions     WalletTransaction[]
  rechargeAttempts WalletRechargeAttempt[]
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
}

model AgentPaymentMilestone {
  id                String                  @id @default(cuid())
  agentId           String
  agent             User                    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  percentage        Decimal                 @db.Decimal(5, 2)
  dueType           PaymentMilestoneDueType
  daysBeforeCheckIn Int?
  sortOrder         Int                     @default(0)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@index([agentId, sortOrder])
  @@index([agentId, dueType, daysBeforeCheckIn])
}

model AgentDocument {
  id           String              @id @default(cuid())
  agentId      String
  agent        User                @relation(fields: [agentId], references: [id], onDelete: Cascade)
  documentType String
  description  String?
  fileId       String
  file         StoredFile          @relation(fields: [fileId], references: [id], onDelete: Cascade)
  status       AgentDocumentStatus @default(PENDING)
  reviewRemark String?
  reviewedAt   DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@unique([agentId, documentType])
  @@index([agentId, status, createdAt])
}

model WalletTransaction {
  id           String                @id @default(cuid())
  walletId     String
  wallet       AgentWallet           @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type         WalletTransactionType
  amount       Decimal               @db.Decimal(14, 2)
  balanceAfter Decimal               @db.Decimal(14, 2)
  reference    String?
  description  String?
  createdAt    DateTime              @default(now())

  @@index([walletId, createdAt])
}

model CancellationRule {
  id          String               @id @default(cuid())
  hotelId     String
  hotel       Hotel                @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  ratePlanId  String?
  ratePlan    RatePlan?            @relation(fields: [ratePlanId], references: [id], onDelete: Cascade)
  type        CancellationRuleType
  cutoffHours Int                  @default(0)
