  title                String
  details              String
  status               OperationsLogStatus   @default(OPEN)
  createdByUserId      String
  createdBy            User                  @relation("OperationsLogCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  assignedDepartment   StaffDepartment?
  assignedUserId       String?
  assignedUser         User?                 @relation("OperationsLogAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  reservationId        String?
  reservation          Reservation?          @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  guestProfileId       String?
  guestProfile         GuestProfile?         @relation(fields: [guestProfileId], references: [id], onDelete: SetNull)
  roomId               String?
  room                 Room?                 @relation(fields: [roomId], references: [id], onDelete: SetNull)
  maintenanceTicketId  String?
  maintenanceTicket    MaintenanceTicket?    @relation(fields: [maintenanceTicketId], references: [id], onDelete: SetNull)
  housekeepingTaskId   String?
  housekeepingTask     HousekeepingTask?     @relation(fields: [housekeepingTaskId], references: [id], onDelete: SetNull)
  dueAt                DateTime?
  acknowledgedAt       DateTime?
  acknowledgedByUserId String?
  acknowledgedBy       User?                 @relation("OperationsLogAcknowledger", fields: [acknowledgedByUserId], references: [id], onDelete: SetNull)
  resolvedAt           DateTime?
  resolvedByUserId     String?
  resolvedBy           User?                 @relation("OperationsLogResolver", fields: [resolvedByUserId], references: [id], onDelete: SetNull)
  resolutionNote       String?
  updates              OperationsLogUpdate[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([hotelId, status, businessDate])
  @@index([hotelId, assignedDepartment, status])
  @@index([hotelId, dueAt])
  @@index([reservationId])
  @@index([roomId])
}

model OperationsLogUpdate {
  id           String             @id @default(cuid())
  logEntryId   String
  logEntry     OperationsLogEntry @relation(fields: [logEntryId], references: [id], onDelete: Cascade)
  authorUserId String
  author       User               @relation("OperationsLogUpdateAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)
  note         String
  createdAt    DateTime           @default(now())

  @@index([logEntryId, createdAt])
}

model AuditLog {
  id            String   @id @default(cuid())
  actorUserId   String?
  actor         User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  action        String
  entityType    String
  entityId      String?
  before        Json?
  after         Json?
  ipAddress     String?
  userAgent     String?
  correlationId String?
  createdAt     DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
}

model SiteSetting {
  key       String   @id
  value     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CancellationRequest {
  id             String             @id @default(cuid())
  reservationId  String
  reservation    Reservation        @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  status         CancellationStatus @default(REQUESTED)
  reason         String
  idempotencyKey String             @unique
  requestedById  String?
  requestedBy    User?              @relation("CancellationRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  approvedById   String?
  approvedBy     User?              @relation("CancellationApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  refundAmount   Decimal            @default(0) @db.Decimal(12, 2)
  policyResult   Json
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([reservationId, status])
}

model ReservationModification {
  id              String             @id @default(cuid())
  reservationId   String
  reservation     Reservation        @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  fromVersion     Int
  toVersion       Int
  type            ModificationType
  status          ModificationStatus @default(REQUESTED)
  changes         Json
  priceDifference Decimal            @default(0) @db.Decimal(12, 2)
  idempotencyKey  String             @unique
  createdById     String?
  createdBy       User?              @relation("ModificationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime           @default(now())

  @@index([reservationId, createdAt])
}

model WaitlistEntry {
  id         String    @id @default(cuid())
  hotelId    String
  hotel      Hotel     @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  roomTypeId String?
  roomType   RoomType? @relation(fields: [roomTypeId], references: [id], onDelete: SetNull)
  guestName  String
  email      String
  checkIn    DateTime  @db.Date
  checkOut   DateTime  @db.Date
  rooms      Int       @default(1)
  status     String    @default("WAITING")
  createdAt  DateTime  @default(now())

  @@index([hotelId, checkIn, status])
}
