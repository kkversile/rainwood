model User {
  id                               String                      @id @default(cuid())
  email                            String                      @unique
  passwordHash                     String
  name                             String
  companyName                      String?
  contactPerson                    String?
  mobile                           String?
  gstin                            String?
  place                            String?
  addressLine1                     String?
  addressLine2                     String?
  state                            String?
  pinCode                          String?
  additionalInformation            String?
  role                             UserRole                    @default(RESERVATION)
  staffDepartment                  StaffDepartment?
  jobTitle                         String?
  staffHotelId                     String?
  staffHotel                       Hotel?                      @relation("StaffHotel", fields: [staffHotelId], references: [id], onDelete: SetNull)
  active                           Boolean                     @default(true)
  agentPaymentPolicy               AgentPaymentPolicy?
  bookingPaymentPercent            Decimal?                    @db.Decimal(5, 2)
  tokenVersion                     Int                         @default(0)
  failedLoginCount                 Int                         @default(0)
  lockedUntil                      DateTime?
  refreshTokens                    RefreshToken[]
  auditLogs                        AuditLog[]                  @relation("AuditActor")
  featureSettingsUpdated           FeatureSetting[]            @relation("FeatureSettingUpdatedBy")
  featureOverridesUpdated          HotelFeatureOverride[]      @relation("HotelFeatureOverrideUpdatedBy")
  createdReservations              Reservation[]               @relation("ReservationCreator")
  reconfirmedReservations          Reservation[]               @relation("ReservationReconfirmedBy")
  checkedInReservations            Reservation[]               @relation("ReservationCheckedInBy")
  checkedOutReservations           Reservation[]               @relation("ReservationCheckedOutBy")
  reservationSettlements           ReservationSettlement[]     @relation("SettlementActor")
  settlementOverrides              ReservationSettlement[]     @relation("SettlementOverrideAuthorizer")
  closedBusinessDays               HotelBusinessDay[]          @relation("BusinessDayCloser")
  uploadedFiles                    StoredFile[]                @relation("FileUploader")
  agentDocuments                   AgentDocument[]
  profileImageFileId               String?                     @unique
  profileImageFile                 StoredFile?                 @relation("ProfileImage", fields: [profileImageFileId], references: [id], onDelete: SetNull)
  verifiedPayments                 Payment[]                   @relation("PaymentVerifier")
  requestedCancellations           CancellationRequest[]       @relation("CancellationRequester")
  approvedCancellations            CancellationRequest[]       @relation("CancellationApprover")
  createdModifications             ReservationModification[]   @relation("ModificationCreator")
  postedFolioCharges               ReservationFolioCharge[]    @relation("FolioChargePostedBy")
  voidedFolioCharges               ReservationFolioCharge[]    @relation("FolioChargeVoidedBy")
  postedServiceOrders              GuestServiceOrder[]         @relation("ServiceOrderPostedBy")
  voidedServiceOrders              GuestServiceOrder[]         @relation("ServiceOrderVoidedBy")
  reportedLostFoundItems           LostFoundItem[]             @relation("LostFoundReportedBy")
  assignedLostFoundItems           LostFoundItem[]             @relation("LostFoundAssignedTo")
  returnedLostFoundItems           LostFoundItem[]             @relation("LostFoundReturnedBy")
  disposedLostFoundItems           LostFoundItem[]             @relation("LostFoundDisposedBy")
  openedCashierShifts              CashierShift[]              @relation("CashierShiftOpenedBy")
  closedCashierShifts              CashierShift[]              @relation("CashierShiftClosedBy")
  issuedTaxInvoices                TaxInvoice[]                @relation("TaxInvoiceIssuer")
  cancelledTaxInvoices             TaxInvoice[]                @relation("TaxInvoiceCanceller")
  issuedTaxCreditNotes             TaxCreditNote[]             @relation("TaxCreditNoteIssuer")
  recordedTdsDeductions            TdsDeduction[]              @relation("TdsRecorder")
  reversedTdsDeductions            TdsDeduction[]              @relation("TdsReverser")
  assignedRatePlans                AgentRatePlan[]
  agentRateSlabAssignments         AgentRateSlabAssignment[]
  createdAgentRateSlabs            AgentRateSlab[]             @relation("AgentRateSlabCreatedBy")
  updatedAgentRateSlabs            AgentRateSlab[]             @relation("AgentRateSlabUpdatedBy")
  createdAgentRateSlabAssignments  AgentRateSlabAssignment[]   @relation("AgentRateSlabAssignmentCreatedBy")
  agentRateSheets                  AgentRateSheet[]
  publishedAgentRateSheets         AgentRateSheet[]            @relation("AgentRateSheetPublishedBy")
  createdAgentCategoryRateBands    AgentCategoryRateBand[]     @relation("AgentCategoryRateBandCreatedBy")
  updatedAgentCategoryRateBands    AgentCategoryRateBand[]     @relation("AgentCategoryRateBandUpdatedBy")
  createdAgentCategoryRateDays      AgentCategoryRateDay[]      @relation("AgentCategoryRateDayCreatedBy")
  updatedAgentCategoryRateDays      AgentCategoryRateDay[]      @relation("AgentCategoryRateDayUpdatedBy")
  createdMealPlanSupplementBands   MealPlanGuestSupplementBand[] @relation("MealPlanGuestSupplementBandCreatedBy")
  updatedMealPlanSupplementBands   MealPlanGuestSupplementBand[] @relation("MealPlanGuestSupplementBandUpdatedBy")
  agentHotelRateCategoryAssignments AgentHotelRateCategoryAssignment[] @relation("AgentHotelRateCategoryAgent")
  createdAgentHotelCategoryMappings AgentHotelRateCategoryAssignment[] @relation("AgentHotelRateCategoryCreatedBy")
  updatedAgentHotelCategoryMappings AgentHotelRateCategoryAssignment[] @relation("AgentHotelRateCategoryUpdatedBy")
  guestNotes                       GuestNote[]
  paymentMilestones                AgentPaymentMilestone[]
  createdGroups                    GroupReservation[]          @relation("GroupCreator")
  groupAssignments                 GroupReservation[]          @relation("GroupAgent")
  agentHolds                       InventoryHold[]             @relation("AgentHolds")
  assignedRoomStays                ReservationRoomAssignment[] @relation("RoomAssignmentAssignedBy")
  unassignedRoomStays              ReservationRoomAssignment[] @relation("RoomAssignmentUnassignedBy")
  housekeepingTasksAssigned        HousekeepingTask[]          @relation("HousekeepingTaskAssignee")
  housekeepingTasksCreated         HousekeepingTask[]          @relation("HousekeepingTaskCreator")
  housekeepingTasksCompleted       HousekeepingTask[]          @relation("HousekeepingTaskCompleter")
  housekeepingIssuesReported       HousekeepingTask[]          @relation("HousekeepingIssueReporter")
  maintenanceTicketsReported       MaintenanceTicket[]         @relation("MaintenanceTicketReporter")
  maintenanceTicketsAssigned       MaintenanceTicket[]         @relation("MaintenanceTicketAssignee")
  maintenanceTicketsCreated        MaintenanceTicket[]         @relation("MaintenanceTicketCreator")
  operationsLogEntriesCreated      OperationsLogEntry[]        @relation("OperationsLogCreator")
  operationsLogEntriesAssigned     OperationsLogEntry[]        @relation("OperationsLogAssignee")
  operationsLogEntriesAcknowledged OperationsLogEntry[]        @relation("OperationsLogAcknowledger")
  operationsLogEntriesResolved     OperationsLogEntry[]        @relation("OperationsLogResolver")
  createdBanquetEvents             BanquetEvent[]              @relation("BanquetEventCreator")
  finalizedBanquetBeos             BanquetEventOrder[]         @relation("BanquetBEOFinalizer")
  banquetEventsAsAgent             BanquetEvent[]              @relation("BanquetEventAgent")
  operationsLogUpdates             OperationsLogUpdate[]       @relation("OperationsLogUpdateAuthor")
  createdExpenses                  Expense[]                   @relation("ExpenseCreator")
  approvedExpenses                 Expense[]                   @relation("ExpenseApprover")
  assignedInquiries                BookingInquiry[]            @relation("InquiryAssignee")
  createdInquiryFollowUps          InquiryFollowUp[]           @relation("InquiryFollowUpCreator")
  wallet                           AgentWallet?
  createdAt                        DateTime                    @default(now())
  updatedAt                        DateTime                    @updatedAt

  @@index([staffHotelId, role])
}

model FeatureSetting {
  id          String   @id @default(cuid())
  featureKey  String   @unique
  enabled     Boolean  @default(true)
  updatedById String?
  updatedBy   User?    @relation("FeatureSettingUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt   DateTime @updatedAt
}

model HotelFeatureOverride {
  id          String   @id @default(cuid())
  hotelId     String
  featureKey  String
  enabled     Boolean
  updatedById String?
  hotel       Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  updatedBy   User?    @relation("HotelFeatureOverrideUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([hotelId, featureKey])
  @@index([hotelId])
}

model Permission {
  id          String           @id @default(cuid())
  code        String           @unique
  description String
  roles       RolePermission[]
}

model RolePermission {
  role         UserRole
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([role, permissionId])
}

model RefreshToken {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String    @unique
  familyId     String
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime  @default(now())

  @@index([userId, familyId])
  @@index([expiresAt])
  @@index([familyId, revokedAt])
}

model Hotel {
  id                      String                     @id @default(cuid())
  code                    String                     @unique
  name                    String
  slug                    String                     @unique
  city                    String
  mobile                  String?
  email                   String?
  place                   String?
  propertyType            String?
  location                String?
  country                 String?
  state                   String?
  address                 String?
  pincode                 String?
  latitude                String?
  longitude               String?
  category                String?
  margin                  String?
  powerBackup             Boolean                    @default(false)
  description             String?
  active                  Boolean                    @default(true)
  seoTitle                String?
  seoDescription          String?
  canonicalPath           String?
  ogImageUrl              String?
  virtualTourUrl          String?
  timezoneName            String                     @default("Asia/Kolkata")
  axisPropertyId          String?                    @unique
  rooms                   RoomType[]
  physicalRooms           Room[]
  ratePlanMasters         RatePlanMaster[]
  mealPlanGuestSupplementBands MealPlanGuestSupplementBand[]
  agentHotelRateCategoryAssignments AgentHotelRateCategoryAssignment[]
  images                  HotelImage[]
  videos                  HotelVideo[]
  amenities               HotelAmenity[]
  reviews                 HotelReview[]
  taxes                   Tax[]
  charges                 Charge[]
  supplementaryCharges    HotelSupplementaryCharge[]
  cancellationRules       CancellationRule[]
  policy                  HotelPolicy?
  contacts                HotelContact[]
  documents               HotelDocument[]
  locationProfile         HotelLocationProfile?
  locationAttractions     HotelLocationAttraction[]
  locationTransports      HotelLocationTransport[]
  reservations            Reservation[]
  groups                  GroupReservation[]
  guestProfiles           GuestProfile[]             @relation("GuestPreferredHotel")
  guestNotes              GuestNote[]                @relation("GuestNoteHotel")
  staffUsers              User[]                     @relation("StaffHotel")
  housekeepingTasks       HousekeepingTask[]
  maintenanceTickets      MaintenanceTicket[]
  holds                   InventoryHold[]
  waitlist                WaitlistEntry[]
  businessDays            HotelBusinessDay[]
  promotions              Promotion[]
  rateSeasons             RateSeason[]
  yieldRules              YieldRule[]
  revenueForecasts        RevenueForecastSnapshot[]
  expenseCategories       ExpenseCategory[]
  vendors                 Vendor[]
  expenses                Expense[]
  documentSequences       DocumentSequence[]
  serviceItems            ServiceItem[]
  serviceOrders           GuestServiceOrder[]
  bankAccounts            HotelBankAccount[]
  lostFoundItems          LostFoundItem[]
  cashierShifts           CashierShift[]
  taxProfiles             HotelTaxProfile[]
  taxRules                TaxRule[]
  taxInvoices             TaxInvoice[]
  taxCreditNotes          TaxCreditNote[]
  tdsDeductions           TdsDeduction[]
  corporateLinks          CorporateAccountHotel[]
  corporateRateAgreements CorporateRateAgreement[]
  inquiries               BookingInquiry[]
  operationsLogEntries    OperationsLogEntry[]
  functionSpaces          FunctionSpace[]
  banquetEvents           BanquetEvent[]
  featureOverrides        HotelFeatureOverride[]
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt

  @@index([active, slug])
}

model CommonRoomType {
  id        String     @id @default(cuid())
  code      String     @unique
  name      String
  active    Boolean    @default(true)
  roomTypes RoomType[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([active, code])
}

model FunctionSpace {
  id                  String            @id @default(cuid())
  hotelId             String
  hotel               Hotel             @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name                String
  code                String
  spaceType           FunctionSpaceType @default(OTHER)
  floor               String?
  locationDescription String?
  areaSqFt            Decimal?          @db.Decimal(10, 2)
  capacityTheatre     Int?
  capacityClassroom   Int?
  capacityBoardroom   Int?
  capacityUShape      Int?
  capacityBanquet     Int?
  capacityReception   Int?
  active              Boolean           @default(true)
  outOfService        Boolean           @default(false)
  notes               String?
  functions           BanquetFunction[]
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@unique([hotelId, code])
  @@index([hotelId, active, outOfService])
}

model BanquetEvent {
  id                   String              @id @default(cuid())
  hotelId              String
  hotel                Hotel               @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  eventCode            String              @unique
  eventName            String
  eventType            BanquetEventType    @default(OTHER)
  status               BanquetEventStatus  @default(INQUIRY)
  groupReservationId   String?
  groupReservation     GroupReservation?   @relation(fields: [groupReservationId], references: [id], onDelete: SetNull)
  inquiryId            String?
  inquiry              BookingInquiry?     @relation(fields: [inquiryId], references: [id], onDelete: SetNull)
  corporateId          String?
  corporate            CorporateAccount?   @relation(fields: [corporateId], references: [id], onDelete: SetNull)
  agentId              String?
  agent                User?               @relation("BanquetEventAgent", fields: [agentId], references: [id], onDelete: SetNull)
  primaryContactName   String
  primaryContactMobile String
  primaryContactEmail  String?
  startDate            DateTime            @db.Date
  endDate              DateTime            @db.Date
  expectedPax          Int?
  guaranteedPax        Int?
  notes                String?
  cancellationReason   String?
  createdByUserId      String
  createdBy            User                @relation("BanquetEventCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  functions            BanquetFunction[]
  chargeLines          BanquetChargeLine[]
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([hotelId, status, startDate])
  @@index([hotelId, eventType, startDate])
  @@index([groupReservationId, startDate])
  @@index([corporateId, startDate])
  @@index([inquiryId])
}

model BanquetFunction {
  id              String                @id @default(cuid())
  banquetEventId  String
  banquetEvent    BanquetEvent          @relation(fields: [banquetEventId], references: [id], onDelete: Cascade)
  functionSpaceId String
  functionSpace   FunctionSpace         @relation(fields: [functionSpaceId], references: [id], onDelete: Restrict)
  functionName    String
  functionDate    DateTime              @db.Date
  startTime       String
  endTime         String
  startAt         DateTime
  endAt           DateTime
  setupStyle      BanquetSetupStyle
  expectedPax     Int?
  guaranteedPax   Int?
  status          BanquetFunctionStatus @default(TENTATIVE)
  notes           String?
  beo             BanquetEventOrder?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([functionSpaceId, startAt, endAt, status])
  @@index([banquetEventId, functionDate])
}

model BanquetEventOrder {
  id                String                @id @default(cuid())
  banquetFunctionId String                @unique
  banquetFunction   BanquetFunction       @relation(fields: [banquetFunctionId], references: [id], onDelete: Cascade)
  beoNumber         String                @unique
  status            BanquetBEOStatus      @default(DRAFT)
  finalizedAt       DateTime?
  finalizedById     String?
  finalizedBy       User?                 @relation("BanquetBEOFinalizer", fields: [finalizedById], references: [id], onDelete: SetNull)
  scheduleItems     BanquetScheduleItem[]
  requirements      BanquetRequirement[]
  chargeLines       BanquetChargeLine[]
  operationalNotes  String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([status, finalizedAt])
}

model BanquetScheduleItem {
