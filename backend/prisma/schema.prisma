model HousekeepingTask {
  // PostgreSQL migration 20260927170000_enforce_single_active_housekeeping_task
  // owns a partial unique index so each room has at most one PENDING, ACCEPTED,
  // or CLEANING task while retaining all completed/cancelled history.
  id                   String                 @id @default(cuid())
  hotelId              String
  hotel                Hotel                  @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  roomId               String
  room                 Room                   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  assignedToId         String?
  assignedTo           User?                  @relation("HousekeepingTaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  status               HousekeepingTaskStatus @default(PENDING)
  createdAt            DateTime               @default(now())
  acceptedAt           DateTime?
  cleaningStartedAt    DateTime?
  completedAt          DateTime?
  createdById          String?
  createdBy            User?                  @relation("HousekeepingTaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  completedById        String?
  completedBy          User?                  @relation("HousekeepingTaskCompleter", fields: [completedById], references: [id], onDelete: SetNull)
  note                 String?
  issueNote            String?
  issueReportedAt      DateTime?
  issueReportedById    String?
  issueReportedBy      User?                  @relation("HousekeepingIssueReporter", fields: [issueReportedById], references: [id], onDelete: SetNull)
  updatedAt            DateTime               @updatedAt
  maintenanceTicket    MaintenanceTicket?
  operationsLogEntries OperationsLogEntry[]

  @@index([hotelId, status])
  @@index([roomId, status])
  @@index([assignedToId, status])
}

